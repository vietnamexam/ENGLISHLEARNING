# GEMINI_API_KEY: Required for server-side Gemini AI API calls.
# Configured via Secrets panel or environment variables on the server.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ADMIN_INITIAL_PASSWORD: Initial bootstrap password for the Admin portal (server-side only).
ADMIN_INITIAL_PASSWORD="CHANGE_ME_INITIAL_ADMIN_PASSWORD"

# ADMIN_SESSION_SECRET: Secret key used to sign Admin HttpOnly session cookies.
ADMIN_SESSION_SECRET="CHANGE_ME_RANDOM_HEX_SECRET"
